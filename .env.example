# Chukti AI — Environment Variables Template
# Copy this file to .env.local and fill in real values. NEVER commit .env.local or real secrets.

# Supabase (public client credentials)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key

# Supabase (server-only privileged key — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-project-service-role-key

# Optional direct Postgres URL for migration/test tooling
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# LLM API (Step 3+ — one LLM provider, server-side only)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=replace-with-your-gemini-api-key
EXTRACT_MAX_PER_HOUR=30
